# Sistema
# Obtener con: id -u && id -g
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Red Tailscale
# IP del servidor en la red Tailscale: tailscale ip -4
TAILSCALE_IP=100.x.x.x
# Dominio interno (accesible desde todos los dispositivos Tailscale)
DOMAIN=notflix.internal

# API Keys de los servicios Arr
# Generar con: openssl rand -hex 16
# IMPORTANTE: No cambiar tras el primer arranque (los servicios ya las tienen en config.xml)
RADARR_API_KEY=cambiame_openssl_rand_hex_16
SONARR_API_KEY=cambiame_openssl_rand_hex_16
PROWLARR_API_KEY=cambiame_openssl_rand_hex_16

# qBittorrent WebUI
# NOTA: En el primer arranque qBittorrent genera una contraseña temporal (ver make logs-qbit).
# Cambiarla en la WebUI a este valor antes de ejecutar "make provision".
QBIT_USER=admin
QBIT_PASS=cambiame_contrasena_segura

# Plex claim token — necesario solo en el primer arranque para vincular el servidor
# Obtener en https://www.plex.tv/claim/ (caduca en 4 minutos)
# Dejar vacío tras el primer arranque exitoso
PLEX_CLAIM=

# Versiones de imágenes Docker
# Usar "latest" en primer despliegue, luego pinear a la versión instalada:
#   docker inspect radarr | jq -r '.[0].Config.Image'
# Actualizar un servicio: editar la versión + docker compose up -d <servicio>
RADARR_VERSION=latest
SONARR_VERSION=latest
PROWLARR_VERSION=latest
QBITTORRENT_VERSION=latest
PLEX_VERSION=latest
OVERSEERR_VERSION=latest
CADDY_VERSION=2-alpine
